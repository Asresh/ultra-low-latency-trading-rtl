[tasks]
safety
cover

[options]
safety: mode bmc
safety: depth 20
cover: mode cover
cover: depth 24

[engines]
smtbmc boolector

[script]
read -formal -D FORMAL_AUCTION -sv call_auction_engine.sv
chparam -set PRICES 3 -set SLOTS 3 -set QTY_W 3 -set TAG_W 3 -set EPOCH_W 2 -set OWNER_W 2 call_auction_engine
prep -top call_auction_engine
memory_map
opt

[files]
../call_auction_engine.sv
../auction_codes.svh
auction_properties.svh
